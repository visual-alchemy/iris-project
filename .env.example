# =============================================================================
# Project I.R.I.S. — environment configuration
#
# Copy this file to `.env` and fill in real values for your deployment.
# Never commit `.env` or real secrets to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Backend (Elixir / Phoenix — `iris_api` service)
# -----------------------------------------------------------------------------

# Secret used to sign/encrypt cookies and sessions.
# REQUIRED in production (config/runtime.exs raises if unset).
# Generate a fresh value with:  mix phx.gen.secret
SECRET_KEY_BASE=

# Ecto database connection URL. Used only in production.
# Format: ecto://USER:PASS@HOST:PORT/DATABASE
DATABASE_URL=ecto://postgres:postgres@postgres:5432/iris_engine_dev

# Public hostname of the Phoenix endpoint (used for URL generation).
PHX_HOST=localhost

# Set to "true" to start the Phoenix HTTP server. Required when running the
# release inside a container (otherwise the server does not bind).
PHX_SERVER=true

# Port the Phoenix server listens on (defaults to 4000 if unset).
PORT=4000

# Optional — database connection pool size (defaults to 10).
POOL_SIZE=10

# Optional — set to "1" (or "true") to enable IPv6 for the DB connection.
ECTO_IPV6=

# Optional — libcluster DNS query used for node discovery.
DNS_CLUSTER_QUERY=

# CORS is NOT read from the environment. It is hardcoded to `origins: "*"`
# (allow all) in backend/lib/backend_web/endpoint.ex via the Corsica plug.
# Edit that file directly if you need to restrict allowed origins.

# -----------------------------------------------------------------------------
# Frontend (Next.js — `frontend` service)
# -----------------------------------------------------------------------------

# Backend API base URL used server-side (lib/api.ts) and by the Next.js
# rewrite proxy (next.config.mjs). In docker-compose this points at the
# backend service name.
BACKEND_API_URL=http://iris_api:4000

# Next.js runtime environment. Set to "production" in docker-compose.
NODE_ENV=production

# NOTE: NEXT_PUBLIC_API_URL is listed on the roadmap but is NOT currently read
# by the frontend code. Client-side requests use the relative `/api` proxy.
